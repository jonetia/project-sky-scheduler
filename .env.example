# Copy this to .env for local testing only. Never commit a real .env file.
# In Railway, set these as Variables in the service dashboard instead --
# do not put real values in any file that gets committed to this repo.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Dedicated background-job secret (Supabase Vault: sky_job_secret). Sent as x-sky-job-key.
SKY_JOB_SECRET=your-job-secret-here

# Live-truth phase 2: ingest-aircraft tick interval in milliseconds.
# UNSET OR 0 = disabled, and pg_cron job 5 (*/2 * * * *) remains the scheduler.
# Set to 30000 ONLY AFTER pg_cron job 5 has been disabled -- never both at once.
INGEST_AIRCRAFT_INTERVAL_MS=30000
# Optional tuning; sane defaults are compiled in. Used mainly by the test suite.
# INGEST_AIRCRAFT_MIN_GAP_MS=5000
# INGEST_AIRCRAFT_TIMEOUT_MS=60000
# INGEST_AIRCRAFT_BACKOFF_BASE_MS=30000
# INGEST_AIRCRAFT_BACKOFF_MAX_MS=300000
